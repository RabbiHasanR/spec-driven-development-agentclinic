# Copy to .env. Path to the SQLite database file (created on first migrate).
DATABASE_URL=data/agentclinic.db

# Shared password for the staff login at /login; at least 12 characters.
# Changing it signs everyone out.
STAFF_PASSWORD=

# Signs staff session cookies; at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
